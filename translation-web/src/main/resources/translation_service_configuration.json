{ 
    "detect": {
        "supported": [ "sk", "hr", "pl", "ro", "it", "sv", "bg", "fr", "es"
                     , "cs", "de", "lv", "el", "fi", "nl", "hu", "da", "sl"
                     , "et", "pt", "lt", "ga", "en" ],
        "services": [
            {
                "id": "PANGEANIC",
                "classname": "eu.europeana.api.translation.service.pangeanic.PangeanicLangDetectService"
            },
            {
                "id": "GOOGLE",
                "classname": "eu.europeana.api.translation.service.google.GoogleLangDetectService"
            },
            {
                "id": "GOOGLE_TRSH",
                "classname": "eu.europeana.api.translation.service.google.GoogleLangDetectService",
                "config": "/glang_detect_service_thresholds_medium_precision.json"
                
            },
            {
                "id": "TIKA",
                "classname": "eu.europeana.api.translation.service.tika.ApacheTikaLangDetectService"
            },
            {
                "id": "TIKA_TRSH",
                "classname": "eu.europeana.api.translation.service.tika.ApacheTikaLangDetectService",
                "config": "/tika_service_thresholds_medium_precision.json"
            },    
            {
                "id": "HYBRID",
                "classname": "eu.europeana.api.translation.service.hybrid.HybridLangDetectService",
            	"services": [
					{
                		"classname": "eu.europeana.api.translation.service.google.GoogleLangDetectService",
                		"config": "/glang_detect_service_thresholds_medium_precision.json"
            		},
            		{
                		"classname": "eu.europeana.api.translation.service.tika.ApacheTikaLangDetectService",
                		"config": "/tika_service_thresholds_medium_precision.json"
            		}
            	]	
            }          
        ],
        "default": "PANGEANIC"
    },
    "translate": {
    	"supported": [
            {
                "source": [ "sk", "hr", "pl", "ro", "it", "sv", "bg", "fr", "es"
                     , "cs", "de", "lv", "el", "fi", "nl", "hu", "da", "sl"
                     , "et", "pt", "lt", "ga" ],
                "target": [ "en", "es", "bg", "fr", "ro", "sk", "pt", "de", "ga", "it", "lv", "hu", "nl" ]
            },
            {
                "source": [ "en" ],
                "target": [ "sk", "hr", "pl", "ro", "it", "sv", "bg", "fr", "es"
                     , "cs", "de", "lv", "el", "fi", "nl", "hu", "da", "sl"
                     , "et", "pt", "lt", "ga" ]
            }
        ],
        "services": [
            {
                "id": "GOOGLE", 
                "classname": "eu.europeana.api.translation.service.google.GoogleTranslationService"
            },
            {
                "id": "PANGEANIC", 
                "classname": "eu.europeana.api.translation.service.pangeanic.PangeanicTranslationService"
            },
            {
                "id": "ETRANSLATION", 
                "classname": "eu.europeana.api.translation.service.etranslation.ETranslationTranslationService"
            }
        ],
	 	"mappings": [
            {
                "source": [ "sk", "hr", "pl", "ro", "it", "sv", "bg", "fr", "es",
                "cs", "de", "lv", "el", "fi", "nl", "hu", "da", "sl",
                "et", "pt", "lt", "ga" ],
                "target": [ "en" ],
                "service": "PANGEANIC"
            }
        ],
        "default": "GOOGLE"
    }
}
